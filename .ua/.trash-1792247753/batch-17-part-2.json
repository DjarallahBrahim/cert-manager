      "filePath": "pkg/client/applyconfigurations/utils.go",
      "lineRange": [
        36,
        196
      ],
      "summary": "Returns the generated apply-configuration type for a GroupVersionKind, or nil when no apply configuration exists for that kind.",
      "tags": [
        "registry",
        "type-dispatch",
        "server-side-apply",
        "generated-code"
      ],
      "complexity": "complex",
      "languageNotes": "A single large switch over SchemeGroupVersion.WithKind maps each cert-manager, ACME and meta kind to its apply configuration."
