  "nodes": [
    {
      "id": "file:cmd/controller/app/controller.go",
      "type": "file",
      "name": "controller.go",
      "filePath": "cmd/controller/app/controller.go",
      "summary": "Bootstrap for the cert-manager controller manager: builds the controller context, starts metrics, profiling and healthz servers, acquires leader election, launches informers, and runs the enabled controllers.",
      "tags": ["entry-point", "controller-manager", "bootstrap", "kubernetes", "leader-election"],
      "complexity": "complex",
      "languageNotes": "Uses errgroup for coordinated goroutine shutdown and a context factory to build per-controller contexts."
    },
    {
      "id": "file:cmd/controller/app/options/options.go",
      "type": "file",
      "name": "options.go",
      "filePath": "cmd/controller/app/options/options.go",
      "summary": "Defines the controller CLI flags and constructs the default ControllerConfiguration, then resolves the set of enabled controllers from options and feature gates.",
      "tags": ["configuration", "cli-flags", "options", "controller", "feature-gates"],
      "complexity": "moderate",
      "languageNotes": "Registers pflag options directly onto the versioned config struct and hides deprecated flags with MarkHidden."
    },
    {
      "id": "file:cmd/controller/app/start.go",
      "type": "file",
      "name": "start.go",
      "filePath": "cmd/controller/app/start.go",
      "summary": "Builds the controller's cobra server command, loads and validates the ControllerConfiguration from flags or a config file, and invokes the run function. Blank imports register all controller and issuer implementations.",
      "tags": ["cli", "command", "configuration", "entry-point", "validation"],
      "complexity": "moderate",
      "languageNotes": "Uses blank imports as a registration mechanism so each controller package's init hooks run at startup."
    },
    {
      "id": "file:cmd/controller/main.go",
      "type": "file",
      "name": "main.go",
      "filePath": "cmd/controller/main.go",
